{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mintlify Agent Update API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Update",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Trigger documentation update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mintlify.com/v1/project/update/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Trigger documentation update"
        },
        {
          "info": {
            "name": "Get update status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mintlify.com/v1/project/update-status/:statusId",
            "params": [
              {
                "name": "statusId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get update status"
        }
      ]
    }
  ],
  "bundled": true
}